{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_PLUGIN_OPTION_MCP_URL\" ] && mkdir -p \"${CLAUDE_PLUGIN_DATA}\" && (umask 077 && printf '%s' \"$CLAUDE_PLUGIN_OPTION_MCP_URL\" > \"${CLAUDE_PLUGIN_DATA}/mcp-url\") || true"
          }
        ]
      }
    ]
  }
}
