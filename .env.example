# Copy to .env and fill in. Never commit .env.
# Variables are grouped by the step that first needs them (see AGENTS.md).

# --- Hookdeck Event Gateway (everything) ---
# Project API key for a dedicated, non-production project.
HOOKDECK_API_KEY=
# Project signing secret, used to verify Hookdeck signatures on the bridge's inbound route.
# Dashboard: Project settings > Secrets.
HOOKDECK_SIGNING_SECRET=

# --- Resend ---
# API key that can create webhooks (setup) and, for the e2e and spikes, send email.
RESEND_API_KEY=
# Any address on your account's receiving domain, e.g. test@<id>.resend.app
# (Resend dashboard: Emails > Receiving > ... > Receiving address).
RESEND_INBOUND_ADDRESS=
# A sender address on your verified Resend sending domain.
RESEND_TEST_FROM=

# --- GitHub (optional) ---
# This repo's bridge.config.ts enables GitHub when one of these is set (also set it on a deployed bridge):
# - GITHUB_REPOS (comma-separated owner/name): setup registers the webhooks with GITHUB_TOKEN, a token with the
#   Webhooks (read and write) permission on those repositories. Only `setup` uses the token.
# - GITHUB_WEBHOOK_SECRET (manual mode, at least 16 characters): add webhooks to any repositories yourself, with
#   the source URL `npm run bridge -- setup` prints and this secret. Generate one with: openssl rand -hex 32
# GITHUB_REPOS=
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=

# --- Bridge (stage 5) ---
# How provider events reach the bridge: `cli` in development (hookdeck listen to
# BRIDGE_PORT, no public URL) or `http` when deployed (default on Fly.io).
BRIDGE_INBOUND=cli
# For http inbound only: optional override; on Fly.io the default is https://$FLY_APP_NAME.fly.dev.
# BRIDGE_PUBLIC_URL=
# One HTTP listener for inbound routes and the MCP endpoint.
BRIDGE_PORT=8080
# Secret path segment of the MCP URL (https://<bridge>/mcp/<secret>); the URL is a credential.
# Leave empty and `npm run bridge -- setup` generates one and prints the URL to paste into ChatGPT.
BRIDGE_MCP_SECRET=

# --- Optional (stage 7): OpenAI Secure MCP Tunnel, for private networks ---
# Runtime API key for tunnel-client (the variable name tunnel-client reads).
# CONTROL_PLANE_API_KEY=
# Tunnel id from platform.openai.com/settings/organization/tunnels (tunnel_...), passed as --tunnel-id.
# OPENAI_TUNNEL_ID=

# --- Fly.io (stage 5 deploy) ---
FLY_API_TOKEN=
