# Copy to .env and fill in. Never commit .env.
# Variables are grouped by the step that first needs them (see AGENTS.md).

# --- Hookdeck Event Gateway (everything) ---
# Project API key for a dedicated, non-production project.
HOOKDECK_API_KEY=
# Project signing secret, used to verify Hookdeck signatures on the bridge's inbound route.
# Dashboard: Project settings > Secrets.
HOOKDECK_SIGNING_SECRET=

# --- Resend (spike 3, slice 1) ---
# Full-access API key: the spikes create webhooks as well as send email.
RESEND_API_KEY=
# Any address on your account's receiving domain, e.g. test@<id>.resend.app
# (Resend dashboard: Emails > Receiving > ... > Receiving address).
RESEND_INBOUND_ADDRESS=
# A sender address on your verified Resend sending domain.
RESEND_TEST_FROM=

# --- Bridge (slice 1) ---
# How provider events reach the bridge: `cli` in development (hookdeck listen to
# BRIDGE_INBOUND_PORT, no public URL) or `http` when deployed (default on Fly.io).
BRIDGE_INBOUND=cli
# For http inbound only: optional override; on Fly.io the default is https://$FLY_APP_NAME.fly.dev.
# BRIDGE_PUBLIC_URL=
BRIDGE_INBOUND_PORT=8080
# MCP endpoint, bound to 127.0.0.1 and reached only through tunnel-client.
BRIDGE_MCP_PORT=8081
BRIDGE_DATA_DIR=./data

# --- OpenAI Secure MCP Tunnel (spike 1, slice 1) ---
# Runtime API key for tunnel-client (the variable name tunnel-client reads).
CONTROL_PLANE_API_KEY=
# Tunnel id from platform.openai.com/settings/organization/tunnels (tunnel_...), passed as --tunnel-id.
OPENAI_TUNNEL_ID=

# --- Fly.io (slice 1 deploy) ---
FLY_API_TOKEN=

# --- Later (slice 3) ---
# Key for app-level encryption of subscription secrets. Losing it means subscribers re-subscribe.
# BRIDGE_ENCRYPTION_KEY=
