{
  "name": "@hookdeck/mcp-events-bridge",
  "version": "0.2.0",
  "description": "Turn third-party webhooks into MCP Events for AI agents, with Hookdeck Event Gateway receiving and delivering them.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-events",
    "webhooks",
    "hookdeck",
    "event-gateway",
    "ai-agents",
    "chatgpt",
    "github",
    "resend"
  ],
  "homepage": "https://github.com/hookdeck/mcp-events-bridge#readme",
  "bugs": {
    "url": "https://github.com/hookdeck/mcp-events-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hookdeck/mcp-events-bridge.git"
  },
  "license": "MIT",
  "author": "Hookdeck",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "default": "./dist/providers.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mcp-events-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bridge": "tsx src/cli.ts",
    "e2e": "tsx scripts/e2e.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "magicast": "^0.5.5",
    "standardwebhooks": "^1.1.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^26.6.3",
    "cloudflared": "^0.7.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
