{
  "name": "@hookdeck/mcp-events-bridge",
  "version": "0.0.0",
  "private": true,
  "description": "Turn third-party webhooks into MCP Events, with Hookdeck Event Gateway receiving and delivering.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./providers": "./src/providers.ts"
  },
  "bin": {
    "mcp-events-bridge": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bridge": "tsx src/cli.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "standardwebhooks": "^1.1.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "cloudflared": "^0.7.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
